rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(weddingId) {
      return signedIn()
        && exists(/databases/$(database)/documents/weddings/$(weddingId)/owners/$(request.auth.uid));
    }

    function isPublished(weddingId) {
      return get(/databases/$(database)/documents/weddings/$(weddingId)).data.status == 'published';
    }

    function isDefaultWedding(weddingId) {
      return weddingId == 'default';
    }

    function canReadWedding(weddingId) {
      return isDefaultWedding(weddingId) || isPublished(weddingId) || isOwner(weddingId);
    }

    function canPublicWriteWedding(weddingId) {
      return !isDefaultWedding(weddingId) && isPublished(weddingId);
    }

    match /weddings/{weddingId} {
      allow read: if isDefaultWedding(weddingId) || resource.data.status == 'published' || isOwner(weddingId);
      allow create: if signedIn();
      allow update, delete: if isOwner(weddingId);

      match /owners/{uid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /guests/{guestId} {
        allow get: if canReadWedding(weddingId);
        allow list: if isOwner(weddingId);
        allow create, update: if canPublicWriteWedding(weddingId) || isOwner(weddingId);
        allow delete: if isOwner(weddingId);
      }

      match /scheduleItems/{itemId} {
        allow read: if canReadWedding(weddingId);
        allow write: if isOwner(weddingId);
      }

      match /giftLinks/{giftId} {
        allow read: if canReadWedding(weddingId);
        allow write: if isOwner(weddingId);
      }

      match /weddingParty/{memberId} {
        allow read: if canReadWedding(weddingId);
        allow create, delete: if isOwner(weddingId);
        allow update: if isOwner(weddingId)
          || (
            canPublicWriteWedding(weddingId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitationStatus', 'respondedAt'])
            && request.resource.data.invitationStatus in ['accepted', 'declined']
          );
      }

      match /entranceSongs/{songId} {
        allow read: if canReadWedding(weddingId);
        allow write: if isOwner(weddingId);
      }

      match /importantPeople/{personId} {
        allow get: if canReadWedding(weddingId);
        allow list: if isOwner(weddingId);
        allow create, delete: if isOwner(weddingId);
        allow update: if isOwner(weddingId)
          || (
            canPublicWriteWedding(weddingId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitationStatus', 'respondedAt'])
            && request.resource.data.invitationStatus in ['accepted', 'declined']
          );
      }

      match /vendors/{vendorId} {
        allow read, write: if isOwner(weddingId);
      }

      match /messages/{messageId} {
        allow read: if isOwner(weddingId) || (canReadWedding(weddingId) && resource.data.isVisible == true);
        allow create: if canPublicWriteWedding(weddingId);
        allow update, delete: if isOwner(weddingId);
      }
    }

    match /userWeddings/{uid} {
      allow read, write: if false;

      match /weddings/{weddingId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && (request.auth.uid == uid || isOwner(weddingId))
          && request.resource.data.weddingId == weddingId;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(weddingId));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
