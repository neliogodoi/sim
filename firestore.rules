rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(weddingId) {
      return signedIn()
        && exists(/databases/$(database)/documents/weddings/$(weddingId)/owners/$(request.auth.uid));
    }

    function isPublished(weddingId) {
      return get(/databases/$(database)/documents/weddings/$(weddingId)).data.status == 'published';
    }

    match /weddings/{weddingId} {
      allow read: if resource.data.status == 'published' || isOwner(weddingId);
      allow create: if signedIn();
      allow update, delete: if isOwner(weddingId);

      match /owners/{uid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /guests/{guestId} {
        allow read: if isOwner(weddingId);
        allow create, update: if isPublished(weddingId) || isOwner(weddingId);
        allow delete: if isOwner(weddingId);
      }

      match /scheduleItems/{itemId} {
        allow read: if isPublished(weddingId) || isOwner(weddingId);
        allow write: if isOwner(weddingId);
      }

      match /giftLinks/{giftId} {
        allow read: if isPublished(weddingId) || isOwner(weddingId);
        allow write: if isOwner(weddingId);
      }

      match /weddingParty/{memberId} {
        allow read: if isPublished(weddingId) || isOwner(weddingId);
        allow write: if isOwner(weddingId);
      }

      match /entranceSongs/{songId} {
        allow read: if isPublished(weddingId) || isOwner(weddingId);
        allow write: if isOwner(weddingId);
      }

      match /messages/{messageId} {
        allow read: if isOwner(weddingId) || (isPublished(weddingId) && resource.data.isVisible == true);
        allow create: if isPublished(weddingId);
        allow update, delete: if isOwner(weddingId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
